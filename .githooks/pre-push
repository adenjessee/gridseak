#!/usr/bin/env bash
set -euo pipefail

# Public-mirror pre-push. The private hook excludes a crate that does
# not ship here; this overlay is the copy contributors actually run.

# Gates run here:
#   [1/2] cargo fmt --all -- --check
#   [2/2] cargo test --workspace

if [[ "${SKIP_PRE_PUSH:-0}" == "1" ]]; then
    echo "SKIP_PRE_PUSH=1 set — skipping all pre-push checks."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "Running pre-push checks..."
echo ""

echo "=== [1/2] cargo fmt --check ==="
cargo fmt --all -- --check || {
    echo ""
    echo "ERROR: Formatting check failed. Run 'cargo fmt --all' to fix."
    exit 1
}

echo ""
echo "=== [2/2] cargo test --workspace ==="
cargo test --workspace 2>&1 || {
    echo ""
    echo "ERROR: Tests failed. Fix them before pushing."
    exit 1
}

echo ""
echo "All pre-push checks passed. Pushing..."
